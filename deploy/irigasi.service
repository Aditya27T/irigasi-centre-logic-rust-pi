[Unit]
Description=Irigasi Core Service
After=network.target mosquitto.service
Requires=mosquitto.service

[Service]
Type=simple
User=irigasi
WorkingDirectory=/home/irigasi/app
ExecStart=/home/irigasi/app/irigasi-core
Environment=IRIGASI_CONFIG_PATH=/home/irigasi/app/config.toml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
